  "components": {
    "schemas": {
      "CustomField": {
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Key"
          },
          "label": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Label"
          },
          "type": {
            "$ref": "#/components/schemas/FieldType"
          },
          "options": {
            "items": {
              "type": "string",
              "maxLength": 100,
              "minLength": 1
            },
            "type": "array",
            "title": "Options",
            "default": []
          },
          "required_from": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Required From"
          }
        },
        "type": "object",
        "required": [
          "key",
          "label",
          "type"
        ],
        "title": "CustomField"
      },
      "EscalationRule": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "trigger": {
            "$ref": "#/components/schemas/Trigger"
          },
          "severities": {
            "items": {
              "type": "string",
              "maxLength": 40,
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "type": "array",
            "title": "Severities",
            "default": []
          },
          "notify_emails": {
            "items": {
              "type": "string",
              "format": "email"
            },
            "type": "array",
            "title": "Notify Emails",
            "default": []
          },
          "webhook_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2083,
                "minLength": 1,
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "title": "Webhook Url"
          }
        },
        "type": "object",
        "required": [
          "name",
          "trigger"
        ],
        "title": "EscalationRule"
      },
      "FieldType": {
        "type": "string",
        "enum": [
          "text",
          "picklist",
          "date",
          "user",
          "number"
        ],
        "title": "FieldType"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LogoutOut": {
        "properties": {
          "logout_url": {
            "type": "string",
            "title": "Logout Url"
          }
        },
        "type": "object",
        "required": [
          "logout_url"
        ],
        "title": "LogoutOut"
      },
      "MeOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "is_platform_admin": {
            "type": "boolean",
            "title": "Is Platform Admin"
          },
          "tenants": {
            "items": {
              "$ref": "#/components/schemas/TenantAccess"
            },
            "type": "array",
            "title": "Tenants"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username",
          "display_name",
          "email",
          "is_platform_admin",
          "tenants"
        ],
        "title": "MeOut"
      },
      "Severity": {
        "properties": {
          "levels": {
            "items": {
              "$ref": "#/components/schemas/SeverityLevel"
            },
            "type": "array",
            "minItems": 1,
            "title": "Levels"
          },
          "impacts": {
            "items": {
              "type": "string",
              "maxLength": 40,
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "type": "array",
            "minItems": 1,
            "title": "Impacts"
          },
          "urgencies": {
            "items": {
              "type": "string",
              "maxLength": 40,
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "type": "array",
            "minItems": 1,
            "title": "Urgencies"
          },
          "matrix": {
            "items": {
              "items": {
                "type": "string",
                "maxLength": 40,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Matrix"
          }
        },
        "type": "object",
        "required": [
          "levels",
          "impacts",
          "urgencies",
          "matrix"
        ],
        "title": "Severity",
        "description": "Severity comes from impact x urgency; priority P1 is the most severe level."
      },
      "SeverityLevel": {
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Key"
          },
          "sla": {
            "$ref": "#/components/schemas/SlaTarget"
          }
        },
        "type": "object",
        "required": [
          "key",
          "sla"
        ],
        "title": "SeverityLevel"
      },
      "SlaTarget": {
        "properties": {
          "acknowledge_minutes": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Acknowledge Minutes"
          },
          "triage_minutes": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Triage Minutes"
          },
          "contain_minutes": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Contain Minutes"
          },
          "resolve_minutes": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Resolve Minutes"
          }
        },
        "type": "object",
        "required": [
          "acknowledge_minutes",
          "triage_minutes",
          "contain_minutes",
          "resolve_minutes"
        ],
        "title": "SlaTarget"
      },
      "State": {
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Key"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "terminal": {
            "type": "boolean",
            "title": "Terminal",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "key",
          "name"
        ],
        "title": "State"
      },
      "TenantAccess": {
        "properties": {
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Permissions"
          }
        },
        "type": "object",
        "required": [
          "slug",
          "name",
          "permissions"
        ],
        "title": "TenantAccess"
      },
      "TenantConfig": {
        "properties": {
          "states": {
            "items": {
              "$ref": "#/components/schemas/State"
            },
            "type": "array",
            "minItems": 2,
            "title": "States"
          },
          "custom_fields": {
            "items": {
              "$ref": "#/components/schemas/CustomField"
            },
            "type": "array",
            "title": "Custom Fields"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "escalation_rules": {
            "items": {
              "$ref": "#/components/schemas/EscalationRule"
            },
            "type": "array",
            "title": "Escalation Rules"
          }
        },
        "type": "object",
        "required": [
          "states",
          "custom_fields",
          "severity",
          "escalation_rules"
        ],
        "title": "TenantConfig"
      },
      "TenantIn": {
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "title": "Slug"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "slug",
          "name"
        ],
        "title": "TenantIn"
      },
      "TenantOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "slug",
          "name"
        ],
        "title": "TenantOut"
      },
      "TokenCreated": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "prefix": {
            "type": "string",
            "title": "Prefix"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Scopes"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "revoked_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
