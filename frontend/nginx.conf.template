server {
    listen 8080;
    server_tokens off;
    root /usr/share/nginx/html;

    # Evidence uploads go from the browser straight to object storage.
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self' ${CASEMGR_S3_PUBLIC_ORIGIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    location /api/ {
        proxy_pass ${CASEMGR_API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Malware samples are uploaded through the API; large evidence downloads stream through it.
        client_max_body_size 110m;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location / {
        try_files $uri /index.html;
    }
}
